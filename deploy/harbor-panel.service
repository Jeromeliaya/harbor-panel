[Unit]
Description=Harbor Panel single-host operations workspace
After=network.target

[Service]
Type=simple
User=harbor
Group=harbor
WorkingDirectory=/opt/harbor-panel
EnvironmentFile=/etc/harbor-panel.env
Environment=HARBOR_PANEL_PORT=8088
EnvironmentFile=-/etc/harbor-panel.port
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/harbor-panel/.venv/bin/python /opt/harbor-panel/server.py --port ${HARBOR_PANEL_PORT} --root /srv/harbor-workspace --state-dir /var/lib/harbor-panel --bootstrap-token-file /var/lib/harbor-panel/bootstrap.token
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/harbor-workspace /var/lib/harbor-panel

[Install]
WantedBy=multi-user.target
