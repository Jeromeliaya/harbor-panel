[Unit]
Description=Harbor Panel single-host operations workspace
After=network.target

[Service]
Type=simple
User=harbor
Group=harbor
WorkingDirectory=/opt/harbor-panel
EnvironmentFile=/etc/harbor-panel.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/harbor-panel/.venv/bin/python /opt/harbor-panel/server.py --root /srv/harbor-workspace --state-dir /var/lib/harbor-panel
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/harbor-workspace /var/lib/harbor-panel

[Install]
WantedBy=multi-user.target
