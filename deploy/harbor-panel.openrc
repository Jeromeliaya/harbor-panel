#!/sbin/openrc-run

name="Harbor Panel"
description="Harbor Panel single-host operations workspace"
directory="/opt/harbor-panel"
command="/opt/harbor-panel/.venv/bin/python"
command_args=""
command_user="harbor:harbor"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/harbor-panel.log"
error_log="/var/log/harbor-panel.log"
export PYTHONDONTWRITEBYTECODE=1

start_pre() {
    if [ -r /etc/harbor-panel.port ]; then
        . /etc/harbor-panel.port
        export HARBOR_PANEL_PORT
    fi
    command_args="/opt/harbor-panel/server.py --host 0.0.0.0 --port ${HARBOR_PANEL_PORT:-8088} --root /srv/harbor-workspace --state-dir /var/lib/harbor-panel --bootstrap-token-file /var/lib/harbor-panel/bootstrap.token"
}

depend() {
    need net
    after firewall
}
