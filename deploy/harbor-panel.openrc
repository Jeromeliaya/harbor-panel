#!/sbin/openrc-run

name="Harbor Panel"
description="Harbor Panel single-host operations workspace"
directory="/"
command="${HARBOR_PANEL_DIR:-/opt/harbor-panel}/.venv/bin/python"
command_args=""
command_user="root:root"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/harbor-panel.log"
error_log="/var/log/harbor-panel.log"
export PYTHONDONTWRITEBYTECODE=1

start_pre() {
    if [ -r /etc/harbor-panel.paths ]; then
        . /etc/harbor-panel.paths
    fi
    if [ -r /etc/harbor-panel.port ]; then
        . /etc/harbor-panel.port
        export HARBOR_PANEL_PORT
    fi
    app_dir=${HARBOR_PANEL_DIR:-/opt/harbor-panel}
    state_dir=${HARBOR_PANEL_STATE:-/var/lib/harbor-panel}
    directory=/
    command="$app_dir/.venv/bin/python"
    command_args="$app_dir/server.py --host 0.0.0.0 --port ${HARBOR_PANEL_PORT:-8088} --root / --state-dir $state_dir --bootstrap-token-file $state_dir/bootstrap.token --full-host"
}

depend() {
    need net
    after firewall
}
